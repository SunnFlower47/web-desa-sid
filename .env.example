# ==============================================================================
# ENVIRONMENT TEMPLATE — CIBATU VIBE AI (FRONTEND WEB DESA)
# ==============================================================================
# PERHATIAN: DILARANG MENYIMPAN NILAI RAHASIA / PRODUCTION KEYS DI BERKAS INI.
# Salin berkas ini ke .env untuk konfigurasi lokal Anda.

# --- SERVER-SIDE SECRETS (TIDAK BOLEH MEMAKAI PREFIKS NEXT_PUBLIC_) ---
# URL internal backend Laravel untuk server-to-server proxy Next.js
INTERNAL_API_URL=http://127.0.0.1:8000

# Kunci rahasia signing HMAC-SHA256 untuk protokol CIBATU-PROXY-V2
# WAJIB minimal 32 karakter (buat via `openssl rand -hex 32`) dan SAMA dengan konfigurasi Laravel
PROXY_SIGNING_KEY=
PROXY_KEY_ID=v1

# Kunci rahasia untuk otentikasi proxy berkas/storage (minimal 32 karakter)
BACKEND_SECRET_KEY=

# --- CLIENT-SIDE ENVIRONMENT VARIABLES (TEREKSPOS KE BROWSER) ---
# Canonical URL portal web desa
NEXT_PUBLIC_SITE_URL=https://desa-cibatu.id

# Base URL publik (fallback / opsional jika proxy dinonaktifkan)
NEXT_PUBLIC_API_URL=

# Google reCAPTCHA v2 (Checkbox Widget) Site Key
NEXT_PUBLIC_RECAPTCHA_V2_SITE_KEY=

# Google reCAPTCHA v3 (Invisible) Site Key
NEXT_PUBLIC_RECAPTCHA_V3_SITE_KEY=

# Tenant identifier default (misal: cibatu)
NEXT_PUBLIC_DEFAULT_TENANT=cibatu

# Daftar domain pusat / central domains multi-tenancy (dipisahkan koma)
NEXT_PUBLIC_CENTRAL_DOMAINS=
